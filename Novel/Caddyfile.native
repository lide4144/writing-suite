{
	admin off
	auto_https off
}

# The explicit http:// scheme is required. With a bare hostname in the site
# address Caddy treats the site as HTTPS and answers plain HTTP requests with
# "Client sent an HTTP request to an HTTPS server".
http://127.0.0.1:{$HTTP_PORT} {
	encode gzip

	@api path /api/* /health
	handle @api {
		reverse_proxy 127.0.0.1:8000
	}

	handle {
		reverse_proxy 127.0.0.1:3000
	}
}
