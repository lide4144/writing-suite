{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novel-agent-platform.local/schemas/preset.schema.json",
  "title": "Novel Agent Platform Preset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "planning",
    "context",
    "models",
    "agents",
    "workflow_ref",
    "quality_gate",
    "debug"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{1,127}$"
    },
    "planning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["horizon"],
      "properties": {
        "horizon": {
          "type": "object",
          "additionalProperties": false,
          "required": ["detailed_chapters", "medium_chapters", "arc_chapters"],
          "properties": {
            "detailed_chapters": {"type": "integer", "minimum": 0},
            "medium_chapters": {"type": "integer", "minimum": 0},
            "arc_chapters": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recent_chapters", "retrieve_top_k", "token_budget"],
      "properties": {
        "recent_chapters": {"type": "integer", "minimum": 0},
        "retrieve_top_k": {"type": "integer", "minimum": 0},
        "token_budget": {"type": "integer", "minimum": 1}
      }
    },
    "models": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["model_profile_ref"],
        "properties": {
          "model_profile_ref": {"type": "string", "minLength": 1}
        }
      }
    },
    "agents": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "required": ["enabled", "model_ref"],
        "properties": {
          "enabled": {"type": "boolean"},
          "model_ref": {"type": "string", "minLength": 1}
        }
      }
    },
    "workflow_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "quality_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "max_revision_iterations"],
      "properties": {
        "minimum": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "max_revision_iterations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      }
    },
    "debug": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deterministic", "seed"],
      "properties": {
        "deterministic": {"type": "boolean"},
        "seed": {"type": ["integer", "null"]}
      }
    }
  }
}
