# Native source-development defaults. Copy this file to .env.native.
# PostgreSQL 16 and Redis are expected to run as host services.
# Replace the password before using anything beyond a local trusted machine.
POSTGRES_DB=novel
POSTGRES_USER=novel
POSTGRES_PASSWORD=novel-m0-dev-password

APP_ENV=development
APP_VERSION=0.1.0-m1
DATABASE_URL=postgresql+asyncpg://novel:novel-m0-dev-password@127.0.0.1:5432/novel
REDIS_URL=redis://127.0.0.1:6379/0
PROJECTS_ROOT=./projects
PRESETS_ROOT=./presets
PRESET_SCHEMA_PATH=./schemas/preset.schema.json
# This file is sourced by bash (scripts/native_common.sh), so keep values
# shell-quoted when they contain spaces.
GIT_USER_NAME="Novel Agent Platform"
GIT_USER_EMAIL=novel-agent-platform@localhost
WORKER_HEARTBEAT_KEY=novel:worker:heartbeat
WORKER_HEARTBEAT_TTL_SECONDS=30
WORKER_HEARTBEAT_INTERVAL_SECONDS=5
WORKER_ID=novel-worker-native

# Native Caddy listens on an unprivileged loopback port.
HTTP_PORT=18080
