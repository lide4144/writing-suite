# Local development defaults. Copy this file to .env before starting Compose.
# Replace the password before using anything beyond a local trusted machine.
POSTGRES_DB=novel
POSTGRES_USER=novel
POSTGRES_PASSWORD=novel-m0-dev-password

# Caddy is the only published service. Keep it on loopback unless you have
# explicitly configured a trusted Tailscale/SSH boundary.
HOST_BIND_ADDRESS=127.0.0.1
HTTP_PORT=80

APP_ENV=development
APP_VERSION=0.1.0-m1
CADDY_VERSION=2.11.4
REDIS_URL=redis://redis:6379/0
PROJECTS_ROOT=/data/projects
PRESETS_ROOT=/app/presets
PRESET_SCHEMA_PATH=/app/schemas/preset.schema.json
GIT_USER_NAME=Novel Agent Platform
GIT_USER_EMAIL=novel-agent-platform@localhost
WORKER_HEARTBEAT_KEY=novel:worker:heartbeat
WORKER_HEARTBEAT_TTL_SECONDS=30
WORKER_HEARTBEAT_INTERVAL_SECONDS=5
WORKER_ID=novel-worker-1
